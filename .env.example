# Environment Variables — reverse-yocket
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file with real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reverse_yocket_dev"

# For integration tests — separate DB to avoid polluting dev data
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reverse_yocket_test"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="REPLACE_WITH_RANDOM_32_CHAR_STRING"

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Email (for NextAuth email provider + notifications) ─────────────────────
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="noreply@reverseyocket.com"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="Reverse Yocket <noreply@reverseyocket.com>"

# ─── Optional: Job API ────────────────────────────────────────────────────────
# Adzuna (https://developer.adzuna.com) — free tier available
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""

# ─── Optional: Analytics (Plausible) ─────────────────────────────────────────
NEXT_PUBLIC_PLAUSIBLE_DOMAIN="reverseyocket.com"

# ─── Optional: Error monitoring (Sentry) ─────────────────────────────────────
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
